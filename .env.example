# ----------------------------------------------------------------------------
# Togal Call Coach — environment template
#
# Copy this file to .env.local and fill in the real values:
#     cp .env.example .env.local
#
# .env.local is gitignored and must NEVER be committed. Every key below is read
# SERVER-SIDE only (in route handlers) — none are exposed to the browser.
# In production these are set as Railway service variables, not from a file.
# ----------------------------------------------------------------------------

# Anthropic API key — powers the live AI role-play (server-side only).
# Create one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# HubSpot private app access token — used server-side to pull call data into
# Post-call analysis. This is a Private App access token (sent as a Bearer
# token), NOT a legacy "hapikey" (HubSpot deprecated those in 2022).
#
# Create at: HubSpot → Settings → Integrations → Private Apps → Create.
# Required scope:  crm.objects.calls.read
# Add as well if you want recordings / transcripts:
#   - the recordings scope for the recording URL
#   - the conversation-intelligence scope for call transcripts (if on a plan
#     that includes it)
HUBSPOT_ACCESS_TOKEN=
