# Togal Call Coach — server-side secrets. Copy to .env.local for local dev, or set
# these as Railway service variables in production. NEVER commit real values.
# .env.local is gitignored.

# Anthropic (AI Q&A + roleplay)
ANTHROPIC_API_KEY=

# HubSpot private-app token — the unified call log + contact lookup.
# Required scopes: crm.objects.contacts.read, crm.objects.calls.read
HUBSPOT_ACCESS_TOKEN=

# Quo (OpenPhone) — call transcripts pulled by phone number
QUO_API_KEY=

# Aircall — call transcripts pulled by phone number (needs both ID + token)
AIRCALL_API_ID=
AIRCALL_API_KEY=
